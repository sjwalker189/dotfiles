[user]
	email = sjwalker189@gmail.com
	name = Sam Walker
[core]
	editor = nvim
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[lfs]
	concurrenttransfers = 10
